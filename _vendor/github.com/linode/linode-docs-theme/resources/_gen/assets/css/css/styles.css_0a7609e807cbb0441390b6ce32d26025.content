#ln-docs .transition-none {
  transition-property: none;
}

#ln-docs .transition-all {
  transition-property: all;
}

#ln-docs .transition {
  transition-property: background-color, border-color, color, fill, stroke, opacity, box-shadow, transform;
}

#ln-docs .transition-colors {
  transition-property: background-color, border-color, color, fill, stroke;
}

#ln-docs .transition-opacity {
  transition-property: opacity;
}

#ln-docs .transition-shadow {
  transition-property: box-shadow;
}

#ln-docs .transition-transform {
  transition-property: transform;
}

#ln-docs .ease-linear {
  transition-timing-function: linear;
}

#ln-docs .ease-in {
  transition-timing-function: cubic-bezier(0.4, 0, 1, 1);
}

#ln-docs .ease-out {
  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
}

#ln-docs .ease-in-out {
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
}

#ln-docs .duration-75 {
  transition-duration: 75ms;
}

#ln-docs .duration-100 {
  transition-duration: 100ms;
}

#ln-docs .duration-150 {
  transition-duration: 150ms;
}

#ln-docs .duration-200 {
  transition-duration: 200ms;
}

#ln-docs .duration-300 {
  transition-duration: 300ms;
}

#ln-docs .duration-500 {
  transition-duration: 500ms;
}

#ln-docs .duration-700 {
  transition-duration: 700ms;
}

#ln-docs .duration-1000 {
  transition-duration: 1000ms;
}

