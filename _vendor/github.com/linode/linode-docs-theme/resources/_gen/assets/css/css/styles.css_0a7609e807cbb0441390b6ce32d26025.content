  transition-delay: 75ms;
}

#ln-docs .delay-100 {
  transition-delay: 100ms;
}

#ln-docs .delay-150 {
  transition-delay: 150ms;
}

#ln-docs .delay-200 {
  transition-delay: 200ms;
}

#ln-docs .delay-300 {
  transition-delay: 300ms;
}

#ln-docs .delay-500 {
  transition-delay: 500ms;
}

#ln-docs .delay-700 {
  transition-delay: 700ms;
}

#ln-docs .delay-1000 {
  transition-delay: 1000ms;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes ping {
  75%, 100% {
    transform: scale(2);
    opacity: 0;
  }
}

@keyframes pulse {
  50% {
    opacity: .5;
  }
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(-25%);
    animation-timing-function: cubic-bezier(0.8,0,1,1);
  }

  50% {
    transform: none;
    animation-timing-function: cubic-bezier(0,0,0.2,1);
  }
}

#ln-docs .animate-none {
  animation: none;
}

#ln-docs .animate-spin {
  animation: spin 1s linear infinite;
}

#ln-docs .animate-ping {
  animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
}

#ln-docs .animate-pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

#ln-docs .animate-bounce {
  animation: bounce 1s infinite;
}

.border-t-gray {
  border-color: var(--color-divider);
  border-style: solid;
  border-top-width: 1px;
}

.border-b-gray {
  border-color: var(--color-divider);
  border-style: solid;
  border-bottom-width: 1px;
}

.border-r-gray {
  border-color: var(--color-divider);
  border-style: solid;
  border-right-width: 1px;
}

.border-l-gray {
  border-color: var(--color-divider);
  border-style: solid;
  border-left-width: 1px;
}

.border-l-gray--md {
  border-style: none;
}

@media (min-width: 768px) {
  #ln-docs .border-l-gray--md {
    border-color: var(--color-divider);
    border-style: solid;
    border-left-width: 1px;
  }
}

.border-r-gray--md {
  border-style: none;
}

@media (min-width: 768px) {
  #ln-docs .border-r-gray--md {
    border-color: var(--color-divider);
    border-style: solid;
    border-right-width: 1px;
  }
}

.border-l-transparent {
  border-left-color: transparent;
}

.btn {
  border-radius: 0.25rem;
  font-weight: 600;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  padding-left: 1rem;
  padding-right: 1rem;
  color: var(--color-body-text);
  text-decoration: none;
}

.btn:focus {
  outline: 0;
}

.btn:hover:enabled {
  opacity: 0.75;
}

.btn:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* Used for the icons that acts as butons. */

.btn-icon {
  color: var(--color-body-text);
}

.btn-icon:focus {
  outline: 0;
}

.btn-icon:hover:enabled {
  opacity: 0.75;
}

.btn-icon:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* We do (not always) remove the transparent class on img.onload, which creates this fade-in effect. */

img {
  opacity: 1;
  transition: opacity 0.3s;
}

img.img-transparent {
  opacity: 0;
}

/* Chrome, Safari, Opera, newest Edge {*/

body::-webkit-scrollbar {
  /* width: 0 !important;
    height: 0 !important; */
}

/* Firefox */

body {
  /* overflow: -moz-scrollbars-none; */
}

/* Internet Explorer, Edge */

body {
  /* -ms-overflow-style: none; */
}

/* A thin vertical scrollbar that should always be shown, even if not hovered. */

.scrollbar-v-gray::-webkit-scrollbar {
  -webkit-appearance: none;
  width: 4px;
}

.scrollbar-v-gray::-webkit-scrollbar-thumb {
  border-radius: 2px;
  min-height: 56px;
  background-color: #ededf4;
  -webkit-box-shadow: 0 0 1px rgba(255, 255, 255, 0.5);
}

/* Background */

.chroma {
  background-color: #ffffff;
}

/* Other */

/* Error */

.chroma .err {
  color: #a61717;
  background-color: #e3d2d2;
}

/* LineTableTD */

.chroma .lntd {
  vertical-align: top;
  padding: 0;
  margin: 0;
  border: 0;
}

.chroma .lntd:first-of-type {
  border-right: 1px #dedee3 solid;
  text-align: center;
  margin: 0;
  padding: 0 0.075rem 0 0.075rem !important;
}

.chroma .lntd:nth-of-type(2n) {
  padding-left: 0.5rem;
  padding-right: 0.5rem;
}

/* LineTable */

.chroma .lntable {
  border-spacing: 0;
  padding: 0;
  margin: 0 !important;
  border: 0;
  width: auto;
  overflow: auto;
  display: block;
}

/* LineHighlight */

.chroma .hl {
  display: block;
  width: 100%;
  background-color: #ffffcc;
}

