/* KeywordPseudo */

.dark .chroma .kp {
  color: #66d9ef;
}

/* KeywordReserved */

.dark .chroma .kr {
  color: #66d9ef;
}

/* KeywordType */

.dark .chroma .kt {
  color: #66d9ef;
}

/* Name */

/* NameAttribute */

.dark .chroma .na {
  color: #a6e22e;
}

/* NameBuiltin */

/* NameBuiltinPseudo */

/* NameClass */

.dark .chroma .nc {
  color: #a6e22e;
}

/* NameConstant */

.dark .chroma .no {
  color: #66d9ef;
}

/* NameDecorator */

.dark .chroma .nd {
  color: #a6e22e;
}

/* NameEntity */

/* NameException */

.dark .chroma .ne {
  color: #a6e22e;
}

/* NameFunction */

.dark .chroma .nf {
  color: #a6e22e;
}

/* NameFunctionMagic */

/* NameLabel */

/* NameNamespace */

/* NameOther */

