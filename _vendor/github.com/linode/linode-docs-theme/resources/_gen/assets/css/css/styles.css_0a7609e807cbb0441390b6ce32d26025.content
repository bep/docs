}

/* GenericTraceback */

/* GenericUnderline */

/* TextWhitespace */

.highlight .chroma {
  background: #f2f2f7;
}

.highlight .chroma pre {
  overflow: auto;
}

h1 {
  font-weight: 400;
  font-size: 2.25rem;
  line-height: 1.2em;
  letter-spacing: -.03125em;
  color: var(--color-title);
}

h2 {
  font-weight: 600;
  font-size: 1.5rem;
  line-height: 1.2em;
  letter-spacing: -0.02em;
  color: var(--color-title);
  letter-spacing: -.03125em;
}

h3 {
  font-weight: 600;
  font-size: 1rem;
  color: var(--color-title);
}

h4 {
  font-weight: 600;
  font-size: 1rem;
  color: var(--color-title);
}

a {
  cursor: pointer;
  font-weight: 400;
  --text-opacity: 1;
  color: #A9AAB0;
  color: rgba(169, 170, 176, var(--text-opacity));
  text-decoration: none;
}

a:focus {
  --border-opacity: 1;
  border-color: #90cdf4;
  border-color: rgba(144, 205, 244, var(--border-opacity));
  outline: 0;
}

a:hover {
  color: var(--color-body-text);
}

a.active {
  color: var(--color-brand);
}

hr {
  border: 0;
  height: 0;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
  border-bottom: 1px solid rgba(255, 255, 255, 0.3);
}

/* source-sans-pro-regular - latin */

@font-face {
  font-family: "Source Sans Pro";

  font-style: normal;

  font-weight: 400;

  font-display: swap;

  src: url("../webfonts/source-sans-pro-v14-latin-regular.eot"); /* IE9 Compat Modes */

  src: local(""), url("../webfonts/source-sans-pro-v14-latin-regular.eot?#iefix") format("embedded-opentype"),
        /* IE6-IE8 */ url("../webfonts/source-sans-pro-v14-latin-regular.woff2") format("woff2"),
        /* Super Modern Browsers */ url("../webfonts/source-sans-pro-v14-latin-regular.woff") format("woff"),
        /* Modern Browsers */ url("../webfonts/source-sans-pro-v14-latin-regular.ttf") format("truetype"),
        /* Safari, Android, iOS */ url("../webfonts/source-sans-pro-v14-latin-regular.svg#SourceSansPro") format("svg"); /* Legacy iOS */
}

/* source-sans-pro-600 - latin */

@font-face {
  font-family: "Source Sans Pro";

  font-style: normal;

  font-weight: 600;

  font-display: swap;

  src: url("../webfonts/source-sans-pro-v14-latin-600.eot"); /* IE9 Compat Modes */

  src: local(""), url("../webfonts/source-sans-pro-v14-latin-600.eot?#iefix") format("embedded-opentype"),
        /* IE6-IE8 */ url("../webfonts/source-sans-pro-v14-latin-600.woff2") format("woff2"),
        /* Super Modern Browsers */ url("../webfonts/source-sans-pro-v14-latin-600.woff") format("woff"),
        /* Modern Browsers */ url("../webfonts/source-sans-pro-v14-latin-600.ttf") format("truetype"),
        /* Safari, Android, iOS */ url("../webfonts/source-sans-pro-v14-latin-600.svg#SourceSansPro") format("svg"); /* Legacy iOS */
}

.no-js .main__breadcrumbs {
  visibility: hidden;
}

.breadcrumbs a,
.breadcrumbs span {
  --text-opacity: 1;
  color: #A9AAB0;
  color: rgba(169, 170, 176, var(--text-opacity));
}

/* Allow breadcrumbs to use the available whitespace to avoid wrapping on large screens */

@media (min-width: 992px) {
  .main__content .main__breadcrumbs {
    margin-right: calc(-0.5 * (100vw - 100%) + 24px);
  }

  .is-explorer-open .main__content .main__breadcrumbs {
    margin-right: calc(-1 * (100vw - 100% - var(--width-left-column) - 4rem));
  }
}

.main__breadcrumbs a:hover {
  color: var(--color-brand);
}

.breadcrumbs__icon--home {
  width: 17px;
  height: 14px;
}

@media (min-width: 768px) {
  .breadcrumbs__icon--home {
    width: 18px;
    height: 16px;
  }
}

.explorer__row--after-first a:hover > .bg-container {
  display: block;
  position: absolute;
  background-color: var(--color-brand--light);
  top: 0;
  margin-left: -3rem;
  width: 600px;
}

.explorer__row--after-first a:hover > .bg-container.after-second {
  margin-left: -.75rem;
}

.explorer__row--first {
  width: var(--width-left-column);
  box-sizing: border-box;
  height: calc(var(--height-navbar-row) + 1px);
}

.navbar__row {
  box-sizing: border-box;
  height: var(--height-navbar-row);
}

.navbar__explorer-toggle {
  width: 60px;
  position: relative;
}

.is-topbar-pinned #navbar__icons--left,
.ml-container {
  padding-left: 1rem;
}

@media (min-width: 768px) {
  .is-topbar-pinned #navbar__icons--left,
  .ml-container {
    padding-left: 1.5rem;
  }
}

@media (min-width: 768px) {
  #navbar__icons--left,
.ml-container {
    padding-left: 1rem;
  }

  @media (min-width: 768px) {
    #navbar__icons--left,
  .ml-container {
      padding-left: 1.5rem;
    }
  }

  .navbar__explorer-toggle {
    width: 100%;
    padding-right: 20px;
  }

  #navbar__icons--left {
    width: var(--width-left-column);
  }
}

.navbar__explorer-toggle :after {
  top: 12.5px;
  height: 20px;
  margin-top: auto;
  margin-bottom: auto;
  content: " ";
  position: absolute;
  border-right: 1px var(--color-divider) solid;
  right: 0;
}

@media (min-width: 768px) {
  .navbar__explorer-toggle :after {
    top: 0;
    height: 100%;
  }
}

.navbar__logo svg {
  width: 18px;
  height: 21px;
}

@media (min-width: 768px) {
  .navbar__logo svg {
    width: 24px;
    height: 28px;
  }
}

@media (min-width: 992px) {
  .navbar__logo svg {
    width: 37px;
    height: 43px;
  }
}

@media (max-width: 767px) {
  .is-explorer-open .navbar__explorer-toggle--border-r :after,
    .is-topbar-pinned .navbar__explorer-toggle--border-r :after {
    border-right: none;
  }

  .is-topbar-pinned .navbar__logo {
    margin-right: 1rem;
  }

  .is-topbar-pinned .navbar__explorer-toggle {
    border-color: transparent;
    border-width: 0;
    border-bottom-width: 4px;
    padding-top: 0.5rem;
  }

  .is-topbar-pinned.is-explorer-open .navbar__explorer-toggle {
    border-color: var(--color-brand);
  }

  .navbar__explorer-toggle {
    width: 44px;
  }
}

nav.toc {
  position: relative;
  width: 100%;
  left: calc(100% - var(--width-right-column));
  top: calc(var(--height-navbar-row) + 1px);
  width: var(--width-right-column);
  height: 90vh;
}

@media (max-width: 767px) {
  nav.toc {
    height: 100vh;
  }
}

nav.toc ol {
  padding: 0;
}

nav.toc li {
  display: block;
  list-style-type: none;
  z-index: 10;
}

nav.toc li > a {
  box-sizing: border-box;
  font-weight: 400;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  padding-left: 1rem;
  padding-right: 1rem;
  color: var(--color-body-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: list-item;
  list-style-position: inside;
}

@media (max-width: 767px) {
  nav.toc li.level-2 {
    position: relative;
  }

  nav.toc li.level-2 > a {
    padding-right: 2.5rem;
  }

  nav.toc li > button {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    position: absolute;
    right: 0;
    top: 0;
  }
}

nav.toc li > a:hover {
  background-color: var(--color-brand--light);
}

nav.toc li.active > a {
  --bg-opacity: 1;
  background-color: #edf2f7;
  background-color: rgba(237, 242, 247, var(--bg-opacity));
}

/* LEVEL 2 */

nav.toc li.level-2 > a {
  font-weight: 600;
  font-size: 0.75rem;
  color: var(--color-title);
  list-style-type: decimal-leading-zero;
}

/* LEVEL 3,4 */

nav.toc li.level-3 > a,
nav.toc li.level-4 > a {
  font-weight: 400;
  font-size: 0.75rem;
}

nav.toc li.level-3 > a {
  padding-left: 2rem;
  list-style-type: upper-alpha;
}

nav.toc li.level-4 > a {
  padding-left: 3rem;
  list-style-type: upper-roman;
}

.api dl {
  width: 100%;
  overflow: hidden;
  padding: 0;
  margin: 0;
}

.api dt {
  font-weight: 600;
  float: left;
  clear: left;
  width: 20%;
  padding: 0;
  margin: 0;
}

.api dd {
  width: 80%;
  padding: 0;
  margin: 0;
}

/*
Styles used on content/article type of content sections.
Note that this is usually used in combination with Tailwind's Typography plugin and its prose classes.
*/

.content blockquote.callout {
  border-radius: 0.375rem;
  border-width: 1px;
  font-weight: 400;
  padding-top: 0.75rem;
  padding-bottom: 0.75rem;
  padding-left: 1rem;
  padding-right: 1rem;
  color: var(--color-body-text);
}

@media (max-width: 767px) {
  .content blockquote.callout .code {
    margin-bottom: 0;
  }
}

.content blockquote.callout a {
  color: var(--color-brand);
}

#ln-docs .content blockquote.callout a:hover {
  --text-opacity: 1;
  color: #4EC88B;
  color: rgba(78, 200, 139, var(--text-opacity));
}

.content .callout-title {
  display: block;
  font-size: 1rem;
  line-height: 1.25;
  margin-bottom: 0.5rem;
  color: var(--color-title);
}

.content .callout-body > :first-child {
  margin-top: 0;
}

.content .callout-body > :last-child {
  margin-bottom: 0;
}

.content a {
  color: var(--color-brand);
}

#ln-docs .content a:hover {
  --text-opacity: 1;
  color: #4EC88B;
  color: rgba(78, 200, 139, var(--text-opacity));
}

.content pre,
.content .code {
  --bg-opacity: 1;
  background-color: #F2F2F7;
  background-color: rgba(242, 242, 247, var(--bg-opacity));
  border-radius: 0.375rem;
  margin-bottom: 1rem;
  overflow-x: auto;
  letter-spacing: 1px;
  line-height: 15px;
}

.content .is-scroll-x::-webkit-scrollbar {
  height: 4px;
}

.content .is-scroll-x::-webkit-scrollbar-thumb {
  background-color: #a9aab0;
  opacity: 0.35;
  border-radius: 3px;
}

.content .is-scroll-x::-webkit-scrollbar-track {
  background-color: rgba(169, 170, 176, 0.2);
}

@media (max-width: 767px) {
  #ln-docs .content .code {
    border-radius: 0;
    margin-left: -1rem;
    margin-right: -1rem;
  }
}

@media (max-width: 767px) {
  #ln-docs .content ul .code,
#ln-docs .content ol .code {
    border-radius: 0.375rem;
    margin-left: 0;
    margin-right: 0;
  }
}

.content pre.dark,
.content .code.dark {
  background-color: var(--color-title);
  color: #ffffff;
}

.content pre.light,
.content .code.light,
.content pre {
  background-color: #ededf4;
  color: #5e6065;
}

.content .code pre {
  margin-top: 0.75rem;
  margin-bottom: 0.75rem;
  padding-top: 0.25rem;
  padding-bottom: 0.25rem;
  background-color: transparent;
}

.content .file {
  margin-top: 1rem;
  margin-bottom: 1rem;
}

.content .file .chroma {
  border-bottom-right-radius: 0.375rem;
  border-bottom-left-radius: 0.375rem;
  margin: 0;
}

.content .file .chroma .lntable {
  overflow: inherit;
}

.content .file dd {
  margin-top: 0;
}

.content code {
  border-radius: 0.25rem;
  display: inline;
  font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  padding-left: 0.25rem;
  padding-right: 0.25rem;
}

.content pre {
  border-radius: 0.25rem;
  background-color: #ededf4;
}

.content pre code {
  background-color: transparent;
  border-radius: 0;
  display: block;
  overflow-x: auto;
  padding: 0;
}

.content .highlight tbody td code {
  background-color: transparent;
}

.content table {
  border-collapse: collapse;
  width: 100%;
}

@media (max-width: 767px) {
  #ln-docs .content table {
    margin-left: -1rem;
    margin-right: -1rem;
  }
}

.content table {
  border-style: hidden;
}

@media (max-width: 767px) {
  .content table {
    width: calc(100% + 2rem);
  }
}

.content tbody tr:first-child {
  --border-opacity: 1;
  border-color: #D9DBE1;
  border-color: rgba(217, 219, 225, var(--border-opacity));
  border-top-width: 2px;
}

.content table table {
  margin: 0;
  padding: 0;
}

.content table table td:first-child {
  padding-left: 0;
}

.content table tr:last-child td:first-child {
  border-bottom-left-radius: 10px;
}

.content table tr:last-child td:last-child {
  border-bottom-right-radius: 10px;
}

.content tbody tr td {
  --bg-opacity: 1;
  background-color: #F2F2F7;
  background-color: rgba(242, 242, 247, var(--bg-opacity));
  border-bottom-width: 1px;
  padding: 1rem;
}

.content tbody td code {
  --bg-opacity: 1;
  background-color: #e2e8f0;
  background-color: rgba(226, 232, 240, var(--bg-opacity));
}

.chroma .lntable tbody td:first-child {
  padding-left: 0;
}

.content img.marquee-img {
  border-radius: 0.5rem;
  width: 100%;
}

@media (max-width: 767px) {
  #ln-docs .content .marquee-img-container {
    margin-left: -1rem;
    margin-right: -1rem;
  }
}

@media (max-width: 767px) {
  #ln-docs .content .marquee-img-container img {
    border-radius: 0;
  }
}

@media (max-width: 767px) {
  #ln-docs .content .pull-out {
    border-radius: 0;
    margin-left: -1rem;
    margin-right: -1rem;
  }
}

@media (max-width: 767px) {
  #ln-docs .content ul .pull-out,
#ln-docs .content ol .pull-out {
    border-radius: 0.375rem;
    margin-left: 0;
    margin-right: 0;
  }
}

.content figure {
  width: 100%;
}

.content img {
  border-radius: 0;
}

@media (min-width: 768px) {
  .content figure {
    width: 75%;
  }

  .content img {
    border-radius: 0.5rem;
  }
}

/* Adjust anchor links vs fixed header height. */

.content :target::before {
  content: "";
  display: block;
  height: 80px;
  margin: -80px 0 0;
}

/*
Make it so the main content column slides over on mobile and
does not get too small on desktop.
*/

.main__inner {
  min-width: 100vw;
}

@media (min-width: 768px) {
  .main__inner {
    min-width: 80%;
  }
}

/*
Bottom border on product navbar
*/

body.type-products .main__navbar {
  border-bottom: 2px solid var( --color-divider );
}

body.type-products .main__navbar nav {
  margin-bottom: -2px;
}

.fullwidth .container {
  max-width: 100%;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* The top level, green, hero block. */

.kind-home__hero {
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

.kind-home__hero a {
  --text-opacity: 1;
  color: #fff;
  color: rgba(255, 255, 255, var(--text-opacity));
}

.is-explorer-open .kind-home__hero {
  padding-left: 2rem;
}

.kind-home .container {
  max-width: 100%;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* All the carousels on the home page. */

.kind-home .carousel__container {
  position: relative;
}

.kind-home .carousel {
  /* These are set by the JS client. */
  --carousel-slide: 0;
  --carousel-page-size--mobile: 2;
  --carousel-page-size: var(--carousel-page-size--mobile);
  /* Calculated. */
  --carsousel-overlap: 0.4; /* Show a fraction of the first tile of next page. */
  --carousel-page-size-real: calc(var(--carousel-page-size) + var(--carsousel-overlap));
  --carsousel-slide-space-x: 1rem;
  --carousel-space-x: 0px;
  --carsousel-left-menu-width: 0px;
  --carousel-slide-width: calc(
        (100vw - var(--carsousel-left-menu-width) - 3rem - var(--carousel-space-x)) / var(--carousel-page-size-real)
    );
  --carousel-slide-height: calc(var(--carousel-slide-width) * 0.7777);
  --carousel-tray-width: calc(var(--carousel-slide-count) * var(--carousel-slide-width));
  --carousel-translate-x: calc(-1 * var(--carousel-slide) * var(--carousel-slide-width));
}

/* Avoid doing this on mobile as the tiles would be too small. In that situation the main area is grayed out. */

@media (min-width: 768px) {
  .kind-home.is-explorer-open .carousel {
    --carsousel-left-menu-width: var(--width-left-column);
  }
}

.kind-home .carousel--square {
  --carousel-slide-height: var(--carousel-slide-width);
  min-height: var(--carousel-slide-height);
}

.kind-home .carousel {
  min-height: var(--carousel-slide-height);
}

/* The Q&A slider. */

.kind-home .carousel.qa {
  --carousel-slide-height: 10rem;
}

/* Make all the other section sliders square. */

.kind-home .carousel:not(.qa) {
  --carousel-slide-height: var(--carousel-slide-width);
}

@media (min-width: 768px) {
  .kind-home .carousel {
    --carousel-page-size: var(--carousel-page-size--md);
  }

  .kind-home.is-explorer-open .carousel {
    --carousel-page-size: calc(var(--carousel-page-size--md) - 1);
  }
}

@media (min-width: 992px) {
  .kind-home .carousel {
    --carousel-page-size: var(--carousel-page-size--lg);
  }

  .kind-home.is-explorer-open .carousel {
    --carousel-page-size: calc(var(--carousel-page-size--lg) - 1);
  }
}

@media (min-width: 1280px) {
  .kind-home .carousel {
    --carousel-page-size: var(--carousel-page-size--xl);
  }

  .kind-home.is-explorer-open .carousel {
    --carousel-page-size: calc(var(--carousel-page-size--xl) - 1);
  }
}

/* This is just a pseudo-declaration to be able to read the pupdated --carousel-page-size on the client. */

.kind-home .carousel .page-size {
  z-index: var(--carousel-page-size);
  display: none;
}

.kind-home .carousel__viewport {
  overflow-x: visible;
}

.kind-home .carousel__tray {
  width: var(--carousel-tray-width);
  will-change: transform;
  transition: transform 0.5s;
  transform: translateX(var(--carousel-translate-x));
}

.kind-home .kind-home--menu-state-is-changing .carousel__tray {
  transition: none;
}

.kind-home .carousel__tray > * + * {
  margin-right: var(--carsousel-slide-space-x);
}

.kind-home .carousel__item--height {
  height: var(--carousel-slide-height);
}

.kind-home .carousel__item {
  width: var(--carousel-slide-width);
  height: var(--carousel-slide-height);
}

.search-input[contenteditable][placeholder]:empty:before {
  content: attr(placeholder);
  position: absolute;
  color: #a9aab0;
  background-color: transparent;
}

.search-input[contenteditable] {
  white-space: nowrap;
}

.search-panel em {
  background-color: var(--color-brand--light);
  font-style: normal;
}

/* Utility classes to show/hide content. */

.show-if-topbar-is-pinned {
  display: none;
}

.is-topbar-pinned .show-if-topbar-is-pinned {
  display: block;
}

.is-topbar-pinned .hide-if-topbar-is-pinned {
  display: none !important;
}

.is-not-topbar-pinned .hide-if-topbar-is-not-pinned {
  display: none !important;
}

.show-if-search-input-is-open {
  display: none;
}

.is-not-search-panel_filters-open .hide-if-is-not-search-panel_filters-open {
  display: none !important;
}

.is-search-input-open .show-if-search-input-is-open {
  display: block;
}

.is-search-panel-open .hide-if-search-panel-open {
  display: none !important;
}

.is-not-toc .hide-if-is-not-toc {
  display: none;
}

/* Top navigation grid. */

.grid--base #navbar {
  --num-rows: 1;
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  grid-auto-rows: minmax(var(--height-navbar-row), auto);
  justify-items: end;
}

.grid--base #navbar__breadcrumbs {
  display: none;
}

.no-js .grid--base #navbar__breadcrumbs {
  display: block;
}

@media (min-width: 768px) {
  .is-topbar-pinned .grid--base #navbar__breadcrumbs {
    display: block;
  }
}

.is-topbar-pinned.is-not-search-panel-open .grid--base #navbar {
  grid-template-columns: auto 60px 1fr auto;
}

.is-topbar-pinned.is-not-search-panel-open .grid--base #navbar__search-input .search-input {
  display: none;
}

.is-topbar-pinned.is-search-panel-open .grid--base #navbar__breadcrumbs {
  display: none;
}

.no-js .grid--base #navbar__toc,
.no-js .grid--base #navbar__search-input {
  display: none;
}

.no-js .grid--base .navbar__explorer-toggle {
  display: none;
}

@media (max-width: 767px) {
  .is-not-topbar-pinned.is-explorer-open .grid--base #navbar__icons--left .navbar__logo {
    display: none;
  }
}

@media (max-width: 767px) {
  .is-not-topbar-pinned .grid--base #navbar__toc {
    width: 64px;
  }
}

.grid--base #navbar__toc {
  width: var(--width-right-column);
}

/* The main search panel; search listing and the filters. */

.grid--base .search-panel {
  height: 100%;
  display: grid;
  grid-template-rows: auto auto;
  grid-template-columns: auto;
}

@media (min-width: 992px) {
  #ln-docs .grid--base .search-panel__filters {
    padding-top: 3.5rem;
  }
}

.grid--base .search-panel__filters {
  grid-row: 1;
}

.grid--base .search-panel__results {
  padding-top: 2rem;
}

@media (min-width: 768px) {
  #ln-docs .grid--base .search-panel__results {
    padding-top: 2.5rem;
  }
}

.grid--base .search-panel__results {
  grid-row: 2;
}

@media (min-width: 992px) {
  .grid--base .search-panel {
    grid-template-rows: auto;
    grid-template-columns: auto 389px;
  }

  .grid--base .search-panel__filters {
    grid-row: 1;
  }

  .grid--base .search-panel__results {
    max-width: 1100px; /* Excluding padding, this will give a max 956px width search result panel on larger screens. */
    grid-row: 1;
  }
}

@media (max-width: 767px) {
  .is-search-panel_filters-open .grid--base .search-panel__results {
    display: none;
  }
}

.grid--base {
  width: 100vw;
  min-height: 100vh;
  margin: 0;
  padding: 0;
}

.grid--base {
  --num-rows: 3; /* Number of grid rows including the Linode menu header. */
  --row-explorer: 2; /* The grid row for the left side explorer menu. */
  --row-main: 3; /* The grid row for the main content. */
  --col-navbar: 1; /* The grid column for the top navbar. */
  --height-linode-menu-row: 52px;
  --height-navbar-row: 45px;
  --width-left-column: 240px;
  --width-right-column: 240px;
  display: grid;
  grid-auto-rows: minmax(var(--height-navbar-row), auto);
  grid-template-columns: var(--width-left-column) minmax(0, 1fr);
  grid-template-rows: var(--height-linode-menu-row) repeat(var(--num-rows), auto);
}

.is-explorer-open .grid--base {
  --col-navbar: 2;
}

.is-explorer-open.is-topbar-pinned .grid--base {
  --col-navbar: 1;
  --row-explorer: 3;
}

/* Smaller mobiles, e.g. iPhone 5 */

@media screen and (max-width: 321px) {
  .grid--base {
    --width-right-column: 190px;
  }
}

@media (min-width: 768px) {
  .grid--base {
    --row-explorer: 3;
    --col-navbar: 1;
    --height-navbar-row: 45px;
    --width-left-column: 255px;
    --width-right-column: 255px;
    --height-linode-menu-row: 62px;
  }

  .is-explorer-open .grid--base {
    --col-navbar: 1;
  }
}

@media (min-width: 992px) {
  .grid--base {
    --height-navbar-row: 55px;
    --width-left-column: 334px;
    --width-right-column: 334px;
  }
}

@media (min-width: 992px) {
  .grid--base {
    --height-linode-menu-row: 106px;
  }
}

.grid--base #linode-menus {
  grid-column: 1 / -1;
}

.grid--base #navbar {
  grid-column: var(--col-navbar) / -1;
}

.is-explorer-open .grid--base #navbar #navbar__search-input,
.is-toc-open .grid--base #navbar #navbar__search-input {
  opacity: 40%;
}

@media (min-width: 768px) {
  .is-explorer-open .grid--base #navbar #navbar__search-input,
    .is-toc-open .grid--base #navbar #navbar__search-input {
    opacity: 100%;
  }
}

.grid--base #explorer {
  grid-row: var(--row-explorer);
}

.is-explorer-open .grid--base #explorer {
  grid-row: var(--row-explorer) / -1;
  grid-column: 1;
}

.is-not-explorer-open .grid--base #explorer {
  display: none;
}

.is-explorer-open .grid--base #explorer {
  height: 100vh;
  overflow: auto;
}

.grid--base main {
  grid-column: 1 / -1;
  grid-row: var(--row-main);
}

.is-explorer-open .grid--base main {
  grid-column: 2 / -1;
}

.is-explorer-open .grid--base main,
.is-toc-open .grid--base main {
  opacity: 40%;
}

@media (min-width: 768px) {
  .is-explorer-open .grid--base main,
    .is-toc-open .grid--base main {
    opacity: 100%;
  }
}

.is-not-search-panel-open .grid--base .search-panel {
  display: none;
}

.is-search-panel-open .grid--base .main__content {
  display: none;
}

.is-topbar-pinned .grid--base .main__breadcrumbs {
  display: none;
}

.is-explorer-open .grid--base main {
  grid-column: 2;
}

.grid--base #footer {
  grid-column: 1 / -1;
}

.is-explorer-open .grid--base #footer {
  grid-column: 2 / -1;
  grid-row: calc(var(--row-main) + 1) / -1;
}

.grid--base .top--navbar-row {
  top: calc(var(--height-navbar-row) + 1px);
}

html {
  font-size: 16px;
}

@media (max-width: 991px) {
  html {
    font-size: 14px;
  }
}

/* Hide pre-initialized DOM elements. */

[x-cloak] {
  display: none !important;
}

body,
html {
  width: 100vw;
  min-height: 100vh;
  line-height: 1.25;
  margin: 0;
  padding: 0;
  color: var(--color-body-text);
}

body {
  -moz-osx-font-smoothing: grayscale;
  -webkit-font-smoothing: antialiased;
  fill: currentColor; /* Applies to SVG only */
}

@media (min-width: 992px) {
  #ln-docs .is-not-explorer-open .container {
    margin-left: auto;
    margin-right: auto;
  }
}

.turbolinks-progress-bar {
  background-color: var(--color-brand);
  opacity: 0.35;
  height: 3px;
}

@media (max-width: 767px) {
  #ln-docs .pull-out {
    border-radius: 0;
    margin-left: -1rem;
    margin-right: -1rem;
  }
}

.full-width {
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
}

.is-explorer-open .full-width {
  margin-left: -1.5rem;
  margin-right: -1.5rem;
}

@media (min-width: 768px) {
  .block--md {
    display: block !important;
  }
}

@media (min-width: 992px) {
  .block--lg {
    display: block !important;
  }
}

/* Helper class to limit a text block to two lines. */

.two-lines-ellipsis {
  display: block;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Helper class to limit a text block to three lines. */

.three-lines-ellipsis {
  display: block;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 
These matches the padding elements of the container class (but without the width attributes)
for the smaller screens.
 */

.pl-container,
.ml-container {
  padding-left: 1rem;
}

.pr-container,
.mr-container {
  padding-right: 1rem;
}

@media (min-width: 768px) {
  .pl-container,
  .ml-container {
    padding-left: 1.5rem;
  }

  .pr-container,
  .mr-container {
    padding-right: 1.5rem;
  }
}

.px-container,
.mx-container,
.ml-container {
  padding-left: 1rem;
}

.px-container,
.mx-container,
.mr-container {
  padding-right: 1rem;
}

@media (min-width: 768px) {
  .px-container,
.mx-container,
  .ml-container {
    padding-left: 1.5rem;
  }

  .px-container,
.mx-container,
  .mr-container {
    padding-right: 1.5rem;
  }
}

@media (min-width: 1280px) {
  .xl\:prose {
    color: var(--color-body-text);
    max-width: 65ch;
  }

  .xl\:prose [class~="lead"] {
    color: #4a5568;
    font-size: 1.25em;
    line-height: 1.6;
    margin-top: 1.2em;
    margin-bottom: 1.2em;
  }

  .xl\:prose a {
    color: var(--color-brand);
    text-decoration: none;
  }

  .xl\:prose strong {
    font-weight: 600;
  }

  .xl\:prose ol {
    counter-reset: list-counter;
    margin-top: 1em;
    margin-bottom: 1em;
  }

  .xl\:prose ol > li {
    position: relative;
    counter-increment: list-counter;
    padding-left: 1.75em;
  }

  .xl\:prose ol > li::before {
    content: counter(list-counter) ".";
    position: absolute;
    font-weight: 400;
    color: #718096;
  }

  .xl\:prose ul > li {
    position: relative;
    padding-left: 1.75em;
  }

  .xl\:prose ul > li::before {
    content: "";
    position: absolute;
    background-color: #cbd5e0;
    border-radius: 50%;
    width: 0.375em;
    height: 0.375em;
    top: calc(0.875em - 0.1875em);
    left: 0.25em;
  }

  .xl\:prose hr {
    border-color: #e2e8f0;
    border-top-width: 1px;
    margin-top: 2em;
    margin-bottom: 2em;
  }

  .xl\:prose blockquote {
    font-weight: 400;
    font-style: normal;
    color: var(--color-body-text);
    border-left-width: 0.25rem;
    border-left-color: #e2e8f0;
    quotes: "\201C""\201D""\2018""\2019";
    margin-top: 1em;
    margin-bottom: 1em;
    padding-left: 1em;
  }

  .xl\:prose blockquote p:first-of-type::before {
    content: ;
  }

  .xl\:prose blockquote p:last-of-type::after {
    content: ;
  }

  .xl\:prose h1 {
    color: var(--color-title);
    font-weight: 400;
    font-size: 2.25em;
    margin-top: 0;
    margin-bottom: 1rem;
    line-height: 1.1111111;
  }

  .xl\:prose h2 {
    color: var(--color-title);
    font-weight: 600;
    font-size: 1.5em;
    margin-top: 1.5em;
    margin-bottom: 1rem;
    line-height: 1.3333333;
  }

  .xl\:prose h3 {
    color: var(--color-title);
    font-weight: 600;
    font-size: 1.25em;
    margin-top: 1.5em;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .xl\:prose h4 {
    color: var(--color-title);
    font-weight: 600;
    margin-top: 1.5em;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .xl\:prose figure figcaption {
    color: #718096;
    font-size: 0.875em;
    line-height: 1.4285714;
    margin-top: 0.8571429em;
  }

  .xl\:prose code {
    color: var(--color-body-text);
    font-weight: 400;
    font-size: 85%;
    background-color: #edf2f7;
    padding: 0.2em;
    margin: 0;
    border-radius: 3px;
  }

  .xl\:prose code::before {
    content: ;
  }

  .xl\:prose code::after {
    content: ;
  }

  .xl\:prose pre {
    color: #e2e8f0;
    background-color: #2d3748;
    overflow-x: auto;
    font-size: 0.875em;
    line-height: 1.7142857;
    margin-top: 1em;
    margin-bottom: 1em;
    border-radius: 0.375rem;
    padding-top: 1em;
    padding-right: 1em;
    padding-bottom: 1em;
    padding-left: 1em;
  }

  .xl\:prose pre code {
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    font-weight: 400;
    color: inherit;
    font-size: inherit;
    font-family: inherit;
    line-height: inherit;
  }

  .xl\:prose pre code::before {
    content: "";
  }

  .xl\:prose pre code::after {
    content: "";
  }

  .xl\:prose table {
    width: 100%;
    table-layout: auto;
    text-align: left;
    margin-top: 2em;
    margin-bottom: 2em;
    font-size: 0.875em;
    line-height: 1.7142857;
  }

  .xl\:prose thead {
    color: #1a202c;
    font-weight: 600;
    border-bottom-width: 1px;
    border-bottom-color: #cbd5e0;
  }

  .xl\:prose thead th {
    vertical-align: bottom;
    padding-right: 0.5714286em;
    padding-bottom: 0.5714286em;
    padding-left: 0.5714286em;
  }

  .xl\:prose tbody tr {
    border-bottom-width: 1px;
    border-bottom-color: #e2e8f0;
  }

  .xl\:prose tbody tr:last-child {
    border-bottom-width: 0;
  }

  .xl\:prose tbody td {
    vertical-align: top;
    padding-top: 0.5714286em;
    padding-right: 0.5714286em;
    padding-bottom: 0.5714286em;
    padding-left: 0.5714286em;
  }

  .xl\:prose {
    font-size: 1rem;
    line-height: 1.5;
  }

  .xl\:prose p {
    margin-top: 1em;
    margin-bottom: 1em;
  }

  .xl\:prose img {
    margin-top: 2em;
    margin-bottom: 2em;
  }

  .xl\:prose video {
    margin-top: 2em;
    margin-bottom: 2em;
  }

  .xl\:prose figure {
    margin-top: 2em;
    margin-bottom: 2em;
  }

  .xl\:prose figure > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  .xl\:prose h2 code {
    font-size: 0.875em;
  }

  .xl\:prose h3 code {
    font-size: 0.9em;
  }

  .xl\:prose ul {
    margin-top: 1em;
    margin-bottom: 1em;
  }

  .xl\:prose li {
    margin-top: .5em;
    margin-bottom: .5em;
  }

  .xl\:prose ol > li:before {
    left: 0;
  }

  .xl\:prose > ul > li p {
    margin-top: .5em;
    margin-bottom: .5em;
  }

  .xl\:prose > ul > li > *:first-child {
    margin-top: 0px;
  }

  .xl\:prose > ul > li > *:last-child {
    margin-bottom: 0px;
  }

  .xl\:prose > ol > li > *:first-child {
    margin-top: 0px;
  }

  .xl\:prose > ol > li > *:last-child {
    margin-bottom: 0px;
  }

  .xl\:prose ul ul, .xl\:prose ul ol, .xl\:prose ol ul, .xl\:prose ol ol {
    margin-top: 1em;
    margin-bottom: 1em;
  }

  .xl\:prose hr + * {
    margin-top: 0;
  }

  .xl\:prose h2 + * {
    margin-top: 0;
  }

  .xl\:prose h3 + * {
    margin-top: 0;
  }

  .xl\:prose h4 + * {
    margin-top: 0;
  }

  .xl\:prose thead th:first-child {
    padding-left: 0;
  }

  .xl\:prose thead th:last-child {
    padding-right: 0;
  }

  .xl\:prose tbody td:first-child {
    padding-left: 0;
  }

  .xl\:prose tbody td:last-child {
    padding-right: 0;
  }

  .xl\:prose > :first-child {
    margin-top: 0;
  }

  .xl\:prose > :last-child {
    margin-bottom: 0;
  }

  .xl\:prose {
    font-weight: 400;
  }

  .xl\:prose-sm {
    font-size: 1rem;
    line-height: 1.5;
  }

  .xl\:prose-sm p {
    margin-top: 1em;
    margin-bottom: 1em;
  }

  .xl\:prose-sm [class~="lead"] {
    font-size: 1.2857143em;
    line-height: 1.5555556;
    margin-top: 0.8888889em;
    margin-bottom: 0.8888889em;
  }

  .xl\:prose-sm blockquote {
    margin-top: 1em;
    margin-bottom: 1em;
    padding-left: 1.1111111em;
