}

/* LiteralStringHeredoc */

.dark .chroma .sh {
  color: #e6db74;
}

/* LiteralStringInterpol */

.dark .chroma .si {
  color: #e6db74;
}

/* LiteralStringOther */

.dark .chroma .sx {
  color: #e6db74;
}

/* LiteralStringRegex */

.dark .chroma .sr {
  color: #e6db74;
}

/* LiteralStringSingle */

.dark .chroma .s1 {
  color: #e6db74;
}

/* LiteralStringSymbol */

.dark .chroma .ss {
  color: #e6db74;
}

/* LiteralNumber */

.dark .chroma .m {
  color: #ae81ff;
}

/* LiteralNumberBin */

.dark .chroma .mb {
  color: #ae81ff;
}

/* LiteralNumberFloat */

.dark .chroma .mf {
