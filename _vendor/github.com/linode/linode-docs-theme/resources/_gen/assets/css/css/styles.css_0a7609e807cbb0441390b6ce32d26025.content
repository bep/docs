.border-r-gray {
  border-right-width: 1px;
  border-style: solid;
  border-color: var(--color-divider);
}

.border-l-gray {
  border-left-width: 1px;
  border-style: solid;
  border-color: var(--color-divider);
}

.border-l-gray--md {
  border-style: none;
}

@media (min-width: 768px) {
  .border-l-gray--md {
    border-left-width: 1px;
    border-style: solid;
    border-color: var(--color-divider);
  }
}

.border-r-gray--md {
  border-style: none;
}

@media (min-width: 768px) {
  .border-r-gray--md {
    border-right-width: 1px;
    border-style: solid;
    border-color: var(--color-divider);
  }
}

.border-l-transparent {
  border-left-color: transparent;
}

.btn {
  border-radius: 0.25rem;
  padding-left: 1rem;
  padding-right: 1rem;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  font-weight: 600;
  color: var(--color-body-text);
  text-decoration: none;
}

.btn:focus {
  outline: 2px solid transparent;
  outline-offset: 2px;
}

.btn:hover:enabled {
  opacity: 0.75;
}

.btn:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* Used for the icons that acts as butons. */

.btn-icon {
  color: var(--color-body-text);
}

.btn-icon:focus {
  outline: 2px solid transparent;
  outline-offset: 2px;
}

.btn-icon:hover:enabled {
  opacity: 0.75;
}

.btn-icon:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* We do (not always) remove the transparent class on img.onload, which creates this fade-in effect. */

img {
  opacity: 1;
  transition: opacity 0.3s;
}

img.img-transparent {
  opacity: 0;
}

/* Chrome, Safari, Opera, newest Edge {*/

body::-webkit-scrollbar {
  /* width: 0 !important;
    height: 0 !important; */
}

/* Firefox */

body {
  /* overflow: -moz-scrollbars-none; */
}

/* Internet Explorer, Edge */

body {
  /* -ms-overflow-style: none; */
}

/* A thin vertical scrollbar that should always be shown, even if not hovered. */

.scrollbar-v-gray::-webkit-scrollbar {
  -webkit-appearance: none;
  width: 4px;
}

.scrollbar-v-gray::-webkit-scrollbar-thumb {
  border-radius: 2px;
  min-height: 56px;
  background-color: #ededf4;
  -webkit-box-shadow: 0 0 1px rgba(255, 255, 255, 0.5);
}

/* Background */

.chroma {
  background-color: #ffffff;
}

/* Other */

.chroma .x {
}

/* Error */

.chroma .err {
  color: #a61717;
  background-color: #e3d2d2;
}

/* LineTableTD */

.chroma .lntd {
  vertical-align: top;
  padding: 0;
  margin: 0;
  border: 0;
}

.chroma .lntd:first-of-type {
  border-right: 1px #dedee3 solid;
  text-align: center;
  margin: 0;
  padding: 0 0.075rem 0 0.075rem !important;
}

.chroma .lntd:nth-of-type(2n) {
  padding-left: 0.5rem;
  padding-right: 0.5rem;
}

/* LineTable */

.chroma .lntable {
  border-spacing: 0;
  padding: 0;
  margin: 0 !important;
  border: 0;
  width: auto;
  overflow: auto;
  display: block;
}

/* LineHighlight */

.chroma .hl {
  display: block;
  width: 100%;
  background-color: #ffffcc;
}

/* LineNumbersTable */

.chroma .lnt {
  color: #7f7f7f;
