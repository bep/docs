@media (min-width: 640px) {
  .sm\:prose {
    color: var(--color-body-text);
    font-weight: 400;
    line-height: 1.5;
  }

  .sm\:prose strong {
    font-weight: 600;
  }

  .sm\:prose a {
    color: var(--color-brand);
    text-decoration: none;
