/* Main beps colors, these are also referenced in tailwind.config.js.. */

:root {
  --color-brand: #02b159;
  --color-brand--decimal: 2, 177, 89;
  --color-brand--light: rgba(var(--color-brand--decimal), 0.2);
  --color-title: #32363b;
  --color-body-text: #5e6065;
  --color-divider: #eaeaeb;
}

