.chroma .gt {
  color: #aa0000;
}

/* GenericUnderline */

.chroma .gl {
  text-decoration: underline;
}

/* TextWhitespace */

.chroma .w {
  color: #bbbbbb;
}

/* Background */

.dark .chroma {
  color: #f8f8f2;
  background-color: #272822;
}

/* Other */

/* Error */

.dark .chroma .err {
  color: #960050;
  background-color: #1e0010;
}

/* LineTableTD */

.dark .chroma .lntd {
  vertical-align: top;
  padding: 0;
  margin: 0;
  border: 0;
}

/* LineTable */

.dark .chroma .lntable {
  border-spacing: 0;
  padding: 0;
  margin: 0;
  border: 0;
  width: auto;
  overflow: auto;
  display: block;
}

/* LineHighlight */

.dark .chroma .hl {
  display: block;
  width: 100%;
  background-color: #ffffcc;
}

/* LineNumbersTable */

.dark .chroma .lnt {
  margin-right: 0.4em;
  padding: 0 0.4em 0 0.4em;
  color: #7f7f7f;
}

/* LineNumbers */

.dark .chroma .ln {
  margin-right: 0.4em;
  padding: 0 0.4em 0 0.4em;
  color: #7f7f7f;
}

/* Keyword */

.dark .chroma .k {
  color: #66d9ef;
}

/* KeywordConstant */

