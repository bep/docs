}

/* LiteralDate */

.dark .chroma .ld {
  color: #e6db74;
}

/* LiteralString */

.dark .chroma .s {
  color: #e6db74;
}

/* LiteralStringAffix */

.dark .chroma .sa {
  color: #e6db74;
}

/* LiteralStringBacktick */

.dark .chroma .sb {
